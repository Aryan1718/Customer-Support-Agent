DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# LLM configuration
# Most hosted/local LLM gateways support the OpenAI-compatible API shape.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

# OpenTelemetry tracing configuration
# Set OTEL_ENABLED=true after installing backend dependencies and adding your provider values.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=customer-support-agent-backend
OTEL_RESOURCE_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint.example.com/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token

# Frontend configuration used during Docker/Vite builds
VITE_API_BASE_URL=http://localhost:8000

# Examples:
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1
